{
  "name": "@minuk-dev/opampcommander-grafana",
  "version": "0.1.0",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --maxWorkers 4",
    "test:ci": "jest --ci --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config eslint.config.mjs --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up -d --wait",
    "format:check": "prettier --check src tests *.ts *.mjs *.js *.json *.yaml"
  },
  "author": "minuk-dev",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/plugin-e2e": "^3.15.0",
    "@grafana/tsconfig": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.0",
    "diagnostics-webpack-plugin": "^1.0.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^11.1.0",
    "identity-obj-proxy": "^3.0.0",
    "imports-loader": "^5.0.0",
    "intersection-observer": "^0.12.2",
    "jest": "^30.5.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.6.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.89.0",
    "sass-loader": "^16.0.0",
    "semver": "^7.7.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "typescript": "5.9.3",
    "webpack": "^5.106.0",
    "webpack-cli": "^6.0.0",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.2.4",
    "@grafana/i18n": "13.2.4",
    "@grafana/runtime": "13.2.4",
    "@grafana/schema": "13.2.4",
    "@grafana/ui": "13.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "7.8.2"
  },
  "packageManager": "npm@11.6.0",
  "private": true
}
